{
	"name": "conrat/vogler-bau",
	"description": "Website Vogler Bau GmbH (TYPO3 14)",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true,
