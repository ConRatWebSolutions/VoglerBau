################
#### HELPER ####
################
# Generic colPos-based content renderer used by the page templates.
#
#  0   = main
#  2   = extra
#  5/6 = two-column "Kontakt"
#  7   = map
#  8   = address
#  9   = full
#  100 = banner
lib.dynamicContent = COA
lib.dynamicContent {
    5 = LOAD_REGISTER
    5 {
        colPos.cObject = TEXT
        colPos.cObject {
            field = colPos
            ifEmpty.cObject = TEXT
            ifEmpty.cObject {
                value.current = 1
                ifEmpty = 0
            }
        }
        pageUid.cObject = TEXT
        pageUid.cObject {
            field = pageUid
            ifEmpty.data = TSFE:id
        }
        contentFromPid.cObject = TEXT
        contentFromPid.cObject {
            data = DB:pages:{register:pageUid}:content_from_pid
            data.insertData = 1
        }
        wrap.cObject = TEXT
        wrap.cObject {
            field = wrap
        }
    }
    20 = CONTENT
    20 {
        table = tt_content
        select {
            includeRecordsWithoutDefaultTranslation = 1
            orderBy = sorting
            where = {#colPos}={register:colPos}
            where.insertData = 1
            pidInList.data = register:pageUid
            pidInList.override.data = register:contentFromPid
        }
        stdWrap {
            dataWrap = {register:wrap}
            required = 1
        }
    }
    90 = RESTORE_REGISTER
}

lib.dynamicContentSlide =< lib.dynamicContent
lib.dynamicContentSlide.20.slide = -1

lib.dynamicContentBannerSlide =< lib.dynamicContentSlide
lib.dynamicContentBannerSlide {
    20.renderObj = FILES
    20.renderObj {
        references {
            table = tt_content
            uid.data = uid
            fieldName = image
        }
        renderObj = IMG_RESOURCE
        renderObj {
            file.import.data = file:current:originalUid
        }
    }
}

#############################
###### Custom Content #######
#############################
lib.fluidContent = FLUIDTEMPLATE
lib.fluidContent {
    templateRootPaths.0 = EXT:c4theme/Resources/Private/Templates/ContentElements/
}

tt_content {
    cr_itemdetail < lib.fluidContent
    cr_itemdetail {
        templateName = CRItemDetail
        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            10 {
                references.fieldName = image
                as = image
            }
        }
    }

    cr_logobanner < lib.fluidContent
    cr_logobanner {
        templateName = CRLogoBanner
        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            10 {
                references.fieldName = image
                as = image
            }
        }
    }

    cr_banner < lib.fluidContent
    cr_banner {
        templateName = CRBanner
        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            10 {
                references.fieldName = image
                as = images
            }
        }
    }
}

