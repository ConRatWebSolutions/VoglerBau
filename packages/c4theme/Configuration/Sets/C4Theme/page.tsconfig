#
# BACKEND LAYOUT: default
#
mod.web_layout.BackendLayouts {
    default {
        title = Standardseite
        config {
            backend_layout {
                colCount = 2
                rowCount = 7
                rows {
                    1.columns.1 {
                        identifier = banner
                        name = Banner
                        colPos = 100
                        colspan = 2
                    }
                    2.columns.1 {
                        identifier = main
                        name = Inhalt
                        colPos = 0
                        colspan = 2
                    }
                    3.columns.1 {
                        identifier = extra
                        name = Extra
                        colPos = 2
                        colspan = 2
                    }
                    4.columns.1 {
                        identifier = full
                        name = Voll
                        colPos = 9
                        colspan = 2
                    }
                    5.columns {
                        1 {
                            identifier = contactLeft
                            name = Kontakt links
                            colPos = 5
                        }
                        2 {
                            identifier = contactRight
                            name = Kontakt rechts
                            colPos = 6
                        }
                    }
                    6.columns.1 {
                        identifier = map
                        name = Karte
                        colPos = 7
                        colspan = 2
                    }
                    7.columns.1 {
                        identifier = address
                        name = Adresse
                        colPos = 8
                        colspan = 2
                    }
                }
            }
        }
    }

    #
    # BACKEND LAYOUT: detailseite
    #
    detailseite {
        title = Detailseite
        config {
            backend_layout {
                colCount = 1
                rowCount = 3
                rows {
                    1.columns.1 {
                        identifier = banner
                        name = Banner
                        colPos = 100
                        colspan = 1
                    }
                    2.columns.1 {
                        identifier = main
                        name = Inhalt
                        colPos = 0
                        colspan = 1
                    }
                    3.columns.1 {
                        identifier = extra
                        name = Extra
                        colPos = 1
                        colspan = 1
                    }
                }
            }
        }
    }
}

#
# NEW CONTENT ELEMENT WIZARD: CR Elements
#
mod.wizards.newContentElement.wizardItems.crElements {
    header = CR Elements
    after = common
    show = cr_itemdetail, cr_logobanner, cr_banner
    elements {
        cr_itemdetail {
            iconIdentifier = cr_itemdetail
            title = LLL:EXT:c4theme/Resources/Private/Language/locallang_db.xlf:wizard.cr_itemdetail
            description = LLL:EXT:c4theme/Resources/Private/Language/locallang_db.xlf:wizard.cr_itemdetail.desc
            tt_content_defValues.CType = cr_itemdetail
        }
        cr_logobanner {
            iconIdentifier = cr_logobanner
            title = LLL:EXT:c4theme/Resources/Private/Language/locallang_db.xlf:wizard.cr_logobanner
            description = LLL:EXT:c4theme/Resources/Private/Language/locallang_db.xlf:wizard.cr_logobanner.desc
            tt_content_defValues.CType = cr_logobanner
        }
        cr_banner {
            iconIdentifier = cr_banner
            title = LLL:EXT:c4theme/Resources/Private/Language/locallang_db.xlf:wizard.cr_banner
            description = LLL:EXT:c4theme/Resources/Private/Language/locallang_db.xlf:wizard.cr_banner.desc
            tt_content_defValues.CType = cr_banner
        }
    }
}
